config {
  type: "table",
  schema: "gold",
  name: "mart_activity_monthly",
  description: "Gold layer - monthly aggregated activity from Stack Overflow. Ready for BI and executive reporting. 171 records from 2008 to 2022.",
  columns: {
    year_month: "Year and month in YYYY-MM format. Primary key of the mart",
    year: "Activity year",
    quarter: "Quarter of the year (1-4)",
    total_questions: "Total questions published in the month",
    answered_questions: "Questions that received an accepted answer",
    answer_rate_pct: "Percentage of questions with an accepted answer over total",
    avg_score: "Average score of questions in the month",
    avg_views: "Average views per question in the month",
    high_impact_count: "Questions with more than 10,000 views in the month",
    low_quality_count: "Questions with a score below -5 in the month",
    avg_engagement_ratio: "Average ratio of (answers + comments) / views for the month",
    avg_days_since_created: "Average days since publication until today",
    _gold_computed_at: "Timestamp when this mart was computed"
  }
}

SELECT
  year_month,
  year,
  quarter,
  COUNT(*)                                        AS total_questions,
  COUNTIF(has_accepted_answer)                    AS answered_questions,
  ROUND(COUNTIF(has_accepted_answer) * 100.0
    / COUNT(*), 2)                                AS answer_rate_pct,
  ROUND(AVG(score), 2)                            AS avg_score,
  ROUND(AVG(view_count), 0)                       AS avg_views,
  COUNTIF(quality_tier = 'high_impact')           AS high_impact_count,
  COUNTIF(quality_tier = 'low_quality')           AS low_quality_count,
  ROUND(AVG(engagement_ratio), 4)                 AS avg_engagement_ratio,
  ROUND(AVG(days_since_created), 0)               AS avg_days_since_created,
  CURRENT_TIMESTAMP()                             AS _gold_computed_at
FROM ${ref("silver", "posts_questions")}
GROUP BY year_month, year, quarter
ORDER BY year_month