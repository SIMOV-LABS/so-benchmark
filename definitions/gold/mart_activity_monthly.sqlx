config {
  type: "table",
  schema: "gold",
  name: "mart_activity_monthly",
  description: "Capa Gold - actividad mensual agregada de Stack Overflow. Listo para BI y reportes ejecutivos. 171 registros de 2008 a 2022.",
  columns: {
    year_month: "Año y mes en formato YYYY-MM. Clave principal del mart",
    year: "Año de la actividad",
    quarter: "Trimestre (1-4)",
    total_questions: "Total de preguntas publicadas en el mes",
    answered_questions: "Preguntas que recibieron una respuesta aceptada",
    answer_rate_pct: "Porcentaje de preguntas con respuesta aceptada sobre el total",
    avg_score: "Score promedio de las preguntas del mes",
    avg_views: "Promedio de vistas por pregunta en el mes",
    high_impact_count: "Preguntas con más de 10,000 vistas en el mes",
    low_quality_count: "Preguntas con score menor a -5 en el mes",
    avg_engagement_ratio: "Promedio del ratio (answers + comments) / views del mes",
    avg_days_since_created: "Promedio de días desde publicación hasta hoy",
    _gold_computed_at: "Timestamp de cuando fue calculado este mart"
  }
}

SELECT
  year_month,
  year,
  quarter,
  COUNT(*)                                        AS total_questions,
  COUNTIF(has_accepted_answer)                    AS answered_questions,
  ROUND(COUNTIF(has_accepted_answer) * 100.0
    / COUNT(*), 2)                                AS answer_rate_pct,
  ROUND(AVG(score), 2)                            AS avg_score,
  ROUND(AVG(view_count), 0)                       AS avg_views,
  COUNTIF(quality_tier = 'high_impact')           AS high_impact_count,
  COUNTIF(quality_tier = 'low_quality')           AS low_quality_count,
  ROUND(AVG(engagement_ratio), 4)                 AS avg_engagement_ratio,
  ROUND(AVG(days_since_created), 0)               AS avg_days_since_created,
  CURRENT_TIMESTAMP()                             AS _gold_computed_at
FROM ${ref("silver", "posts_questions")}
GROUP BY year_month, year, quarter
ORDER BY year_month