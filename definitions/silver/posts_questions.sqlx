config {
  type: "table",
  schema: "silver",
  name: "posts_questions",
  description: "Silver layer - cleaned and enriched Stack Overflow questions. Source: bronze.posts_questions",
  bigquery: {
    partitionBy: "TIMESTAMP_TRUNC(creation_date, YEAR)"
  },
  columns: {
    id: "Unique identifier of the Stack Overflow question",
    title: "Cleaned question title with no extra whitespace",
    creation_date: "Publication date and time in UTC",
    year_month: "Year and month in YYYY-MM format for time-based groupings",
    year: "Publication year extracted from creation_date",
    quarter: "Publication quarter (1-4)",
    score: "Net votes of the question (upvotes minus downvotes)",
    is_positive_score: "True if the score is greater than or equal to zero",
    view_count: "Total number of views on the question",
    answer_count: "Number of answers received",
    comment_count: "Number of comments received",
    has_accepted_answer: "True if the question has a marked accepted answer",
    tags_array: "Array of tags associated with the question, originally pipe-separated",
    tag_count: "Number of tags assigned to the question",
    owner_user_id: "Author user ID. Null for anonymous questions",
    has_owner: "True if the question has an identified author",
    quality_tier: "Quality classification: high_impact, low_quality or normal",
    engagement_ratio: "Engagement ratio calculated as (answers + comments) / views",
    days_since_created: "Days elapsed since publication until today",
    _ingested_at: "Timestamp when the record was loaded into Bronze",
    _batch_id: "Unique ID of the Bronze load process",
    _row_hash: "MD5 hash of key fields for change detection",
    _silver_processed_at: "Timestamp when the record was processed in Silver"
  }
}

SELECT
  id,
  TRIM(title)                               AS title,
  accepted_answer_id,
  answer_count,
  comment_count,
  creation_date,
  TIMESTAMP_TRUNC(creation_date, YEAR)      AS creation_year,
  FORMAT_TIMESTAMP('%Y-%m', creation_date)  AS year_month,
  EXTRACT(YEAR FROM creation_date)          AS year,
  EXTRACT(QUARTER FROM creation_date)       AS quarter,
  favorite_count,
  last_activity_date,
  owner_user_id,
  owner_user_id IS NOT NULL                 AS has_owner,
  score,
  score >= 0                                AS is_positive_score,
  view_count,
  SPLIT(tags, '|')                          AS tags_array,
  ARRAY_LENGTH(SPLIT(tags, '|'))            AS tag_count,
  accepted_answer_id IS NOT NULL            AS has_accepted_answer,
  DATE_DIFF(CURRENT_DATE(), DATE(creation_date), DAY) AS days_since_created,
  SAFE_DIVIDE(answer_count + comment_count, view_count) AS engagement_ratio,
  CASE
    WHEN score < -5          THEN 'low_quality'
    WHEN view_count > 10000  THEN 'high_impact'
    ELSE                          'normal'
  END                                       AS quality_tier,
  _ingested_at,
  _batch_id,
  _row_hash,
  CURRENT_TIMESTAMP()                       AS _silver_processed_at
FROM ${ref("bronze", "posts_questions")}