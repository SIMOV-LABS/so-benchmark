config {
  type: "table",
  schema: "bronze",
  name: "posts_questions",
  description: "Capa Bronze - copia raw de preguntas de Stack Overflow desde GCS bucket. Sin transformaciones.",
  bigquery: {
    partitionBy: "TIMESTAMP_TRUNC(creation_date, YEAR)"
  },
  columns: {
    id: "ID único de la pregunta en Stack Overflow",
    title: "Título original de la pregunta sin modificaciones",
    body: "Contenido completo de la pregunta en formato HTML",
    accepted_answer_id: "ID de la respuesta aceptada. Nulo si no tiene respuesta aceptada",
    answer_count: "Número de respuestas recibidas",
    comment_count: "Número de comentarios recibidos",
    creation_date: "Fecha y hora de publicación en UTC",
    favorite_count: "Número de veces marcada como favorita",
    last_activity_date: "Fecha de última actividad en la pregunta",
    last_edit_date: "Fecha de última edición. Nulo si nunca fue editada",
    owner_display_name: "Nombre público del autor de la pregunta",
    owner_user_id: "ID del usuario autor. Nulo para preguntas anónimas",
    score: "Votos netos (upvotes - downvotes)",
    tags: "Tags separados por pipe. Ejemplo: python|pandas|dataframe",
    view_count: "Número total de vistas",
    _ingested_at: "Timestamp de cuando el registro fue cargado en Bronze",
    _source_system: "Sistema de origen. Siempre stackoverflow",
    _source_table: "Tabla de origen. Siempre posts_questions",
    _batch_id: "ID único del proceso de carga",
    _row_hash: "Hash MD5 de campos clave para detección de cambios"
  }
}

SELECT
  id,
  title,
  body,
  accepted_answer_id,
  answer_count,
  comment_count,
  creation_date,
  favorite_count,
  last_activity_date,
  last_edit_date,
  owner_display_name,
  owner_user_id,
  score,
  tags,
  view_count,
  CURRENT_TIMESTAMP()        AS _ingested_at,
  'stackoverflow'            AS _source_system,
  'posts_questions'          AS _source_table,
  GENERATE_UUID()            AS _batch_id,
  TO_HEX(MD5(CONCAT(
    CAST(id AS STRING), '|',
    CAST(score AS STRING), '|',
    CAST(answer_count AS STRING)
  )))                        AS _row_hash
FROM `bigquery-public-data.stackoverflow.posts_questions`