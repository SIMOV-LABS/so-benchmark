config {
  type: "table",
  schema: "bronze",
  name: "posts_questions",
  description: "Bronze layer - raw copy of Stack Overflow posts_questions from GCS bucket. No transformations applied.",
  bigquery: {
    partitionBy: "TIMESTAMP_TRUNC(creation_date, YEAR)"
  },
  columns: {
    id: "Unique identifier of the Stack Overflow question",
    title: "Original question title without modifications",
    body: "Full question content in HTML format",
    accepted_answer_id: "ID of the accepted answer. Null if no answer has been accepted",
    answer_count: "Number of answers received",
    comment_count: "Number of comments received",
    creation_date: "Publication date and time in UTC",
    favorite_count: "Number of times marked as favorite",
    last_activity_date: "Date of last activity on the question",
    last_edit_date: "Date of last edit. Null if never edited",
    owner_display_name: "Public display name of the question author",
    owner_user_id: "Author user ID. Null for anonymous questions",
    score: "Net votes (upvotes minus downvotes)",
    tags: "Pipe-separated tags. Example: python|pandas|dataframe",
    view_count: "Total number of views",
    _ingested_at: "Timestamp when the record was loaded into Bronze",
    _source_system: "Source system. Always stackoverflow",
    _source_table: "Source table. Always posts_questions",
    _batch_id: "Unique ID of the load process",
    _row_hash: "MD5 hash of key fields for change detection"
  }
}

SELECT
  id,
  title,
  body,
  accepted_answer_id,
  answer_count,
  comment_count,
  creation_date,
  favorite_count,
  last_activity_date,
  last_edit_date,
  owner_display_name,
  owner_user_id,
  score,
  tags,
  view_count,
  CURRENT_TIMESTAMP()        AS _ingested_at,
  'stackoverflow'            AS _source_system,
  'posts_questions'          AS _source_table,
  GENERATE_UUID()            AS _batch_id,
  TO_HEX(MD5(CONCAT(
    CAST(id AS STRING), '|',
    CAST(score AS STRING), '|',
    CAST(answer_count AS STRING)
  )))                        AS _row_hash
FROM `bigquery-public-data.stackoverflow.posts_questions`